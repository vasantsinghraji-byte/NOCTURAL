{
  "name": "nocturnal-client",
  "version": "1.0.0",
  "description": "Nocturnal Healthcare Platform - Frontend",
  "main": "index.js",
  "scripts": {
    "dev": "npm run serve",
    "build": "npm run build:prod",
    "build:dev": "cross-env NODE_ENV=development webpack --config webpack.config.simple.js --mode development",
    "build:optimize": "npm run build:prod",
    "build:prod": "cross-env NODE_ENV=production node build.config.js",
    "serve": "node scripts/serve-static.js public --port=3000",
    "serve:dist": "node scripts/serve-static.js dist --port=3000",
    "clean": "rimraf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "healthcare",
    "platform",
    "frontend"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-loader": "^10.1.1",
    "clean-css": "^5.3.3",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-minifier-terser": "^7.2.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.4.0",
    "rimraf": "^6.1.3",
    "style-loader": "^4.0.0",
    "terser": "^5.50.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^7.2.2"
  },
  "overrides": {
    "@babel/core": "$@babel/core",
    "js-yaml": "4.2.0",
    "ws": "7.5.11"
  },
  "dependencies": {
    "dompurify": "^3.4.14"
  }
}
