{
  "name": "nocturnal-monorepo",
  "version": "1.0.0",
  "description": "Nocturnal Healthcare Platform - Microservices Architecture",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "hooks:install": "node scripts/git-hooks/install-hooks.js",
    "hooks:path": "git config --get core.hooksPath",
    "doctor:local": "node scripts/doctor-local.js",
    "start": "node --max-old-space-size=2048 server.js",
    "dev": "nodemon --max-old-space-size=2048 server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm --prefix client run serve\"",
    "start:all": "concurrently \"npm start\" \"npm --prefix client run serve\"",
    "frontend": "npm --prefix client run serve",
    "build": "npm run build:prod",
    "build:frontend": "npm --prefix client ci --include=dev && npm --prefix client run build",
    "build:client": "npm run build:frontend",
    "build:prod": "cross-env NODE_ENV=production npm run build:frontend",
    "android:add": "npx cap add android",
    "android:version": "node scripts/prepare-android-version.js",
    "android:sync": "npm run android:version && npm run build:prod && npx cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.js",
    "android:release-key": "node scripts/create-android-release-key.js",
    "android:release": "npm run android:sync && node scripts/build-android.js assembleRelease bundleRelease",
    "android:open": "npx cap open android",
    "optimize": "npm run build:frontend",
    "db:indexes": "node scripts/add-indexes.js",
    "db:migrate": "node scripts/add-indexes.js",
    "db:backfill-upload-urls": "node scripts/backfill-upload-file-urls.js",
    "db:backfill-upload-urls:write": "node scripts/backfill-upload-file-urls.js --write",
    "lint": "eslint .",
    "lint:warning-budget": "node scripts/check-eslint-warning-budget.js",
    "lint:fix": "eslint . --fix",
    "scan:csp-html": "node scripts/scan-html-csp.js",
    "audit:inline-styles": "node scripts/audit-inline-styles.js",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "scan:inline-styles:strict": "node scripts/audit-inline-styles.js --strict",
    "monitor:db": "node scripts/monitor-db.js",
    "monitor:rate-limits": "node scripts/monitor-rate-limits.js",
    "monitor": "concurrently \"npm run monitor:db\" \"npm run monitor:rate-limits\"",
    "deploy": "npm run build:prod && npm start",
    "pm2:start": "pm2 start ecosystem.config.js --env development",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop nocturnal-api",
    "pm2:restart": "pm2 restart nocturnal-api",
    "pm2:reload": "pm2 reload nocturnal-api",
    "pm2:delete": "pm2 delete nocturnal-api",
    "pm2:logs": "pm2 logs nocturnal-api",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "pm2:reset": "pm2 reset nocturnal-api",
    "pm2:flush": "pm2 flush",
    "test": "node ./node_modules/jest/bin/jest.js --config jest.fast.config.js",
    "test:all": "node ./node_modules/jest/bin/jest.js",
    "test:watch": "node ./node_modules/jest/bin/jest.js --config jest.fast.config.js --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:e2e:public-funnel": "playwright test tests/e2e/public-funnel.playwright.spec.cjs",
    "test:e2e:csp": "playwright test tests/e2e/csp-console.playwright.spec.cjs",
    "test:smoke": "jest tests/smoke",
    "test:models": "jest tests/unit/models",
    "test:controllers": "jest tests/unit/controllers",
    "test:middleware": "jest tests/unit/middleware",
    "test:utils": "jest tests/unit/utils",
    "test:api": "jest tests/integration",
    "test:ci": "jest --config jest.fast.config.js --ci --coverage --runInBand",
    "test:security-gate": "node ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath tests/unit/security/auth-service-lockdown.test.js tests/integration/auth-me-profile-policy.test.js tests/integration/auth-change-password.test.js",
    "verify:local": "npm run lint && npm test",
    "test:deploy-gate": "npm run build:prod && npm run scan:inline-styles:strict && node ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath tests/unit/validation/frontend-legacy-auth-retirement.test.js tests/unit/validation/frontend-route-helper-centralization.test.js tests/unit/validation/frontend-page-api-dependency-map.test.js tests/unit/validation/frontend-admin-doctor-api-contract.test.js tests/unit/validation/frontend-provider-admin-booking-contract.test.js tests/unit/validation/frontend-auth-flow-standardization.test.js tests/unit/validation/frontend-session-standardization.test.js tests/unit/validation/frontend-runtime-role-routing-and-doctor-dashboard-contract.test.js tests/unit/validation/frontend-build-output-csp-contract.test.js tests/unit/validation/frontend-build-artifact-contract.test.js tests/unit/validation/frontend-final-contract-closures.test.js tests/unit/validation/frontend-canonical-nav-contract.test.js tests/unit/validation/admin-route-contract.test.js tests/smoke/production-entrypoint-health.test.js tests/smoke/production-built-frontend-playwright.test.js && npm run test:e2e:csp",
    "smoke:deployed-auth-cors": "node scripts/smoke-deployed-auth-cors.js",
    "smoke:deployed-service-worker": "node scripts/smoke-deployed-service-worker.js",
    "smoke:deployed-csp": "node scripts/smoke-deployed-csp.js",
    "security:scan": "node scripts/security-scan.js --target http://localhost:5000",
    "security:scan:full": "node scripts/security-scan.js --target http://localhost:5000 --mode full",
    "security:rotate": "node scripts/rotate-secrets.js",
    "security:vault:init": "node scripts/init-vault.js",
    "db:backup": "node scripts/backup-database.js backup",
    "db:backup:list": "node scripts/backup-database.js list",
    "db:backup:restore": "node scripts/backup-database.js restore",
    "db:setup-security": "node scripts/setup-mongodb-security.js",
    "db:setup-replica": "node scripts/setup-replica-set.js",
    "db:enable-auth": "scripts\\enable-mongodb-auth.bat",
    "prepare": "node -e \"const fs=require('node:fs'); if (!fs.existsSync('.git')) process.exit(0); require('./scripts/git-hooks/install-hooks');\"",
    "setup:env": "node scripts/setup-env.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.4.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "file-type": "^22.0.1",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongoose": "^9.7.0",
    "multer": "^2.2.0",
    "multer-s3": "^3.0.1",
    "rate-limit-redis": "^4.2.3",
    "razorpay": "^2.9.6",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-logstash": "^2.0.5",
    "winston-loki": "^6.1.3",
    "xss-clean": "^0.1.4"
  },
  "optionalDependencies": {
    "node-vault": "^0.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/jest": "^30.0.0",
    "baseline-browser-mapping": "^2.10.37",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^8.51.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "playwright": "^1.61.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "axios": "1.16.0",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "gaxios": "7.1.5",
    "ip-address": "10.2.0",
    "js-yaml": "4.2.0",
    "protobufjs": "7.6.3",
    "retry-request": "8.0.3",
    "teeny-request": "10.1.3",
    "uuid": "11.1.1"
  }
}
