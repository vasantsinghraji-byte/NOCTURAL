{
  "name": "@medrush/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript domain types and a typed API client for the MedRush web (Next.js) and mobile (Expo) apps.",
  "type": "module",
  "main": "./src/index.ts",
