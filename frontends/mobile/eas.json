{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "true",
        "MEDRUSH_ALLOW_CLEARTEXT": "true"
      }
    },
    "partner-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "partner",
        "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "true",
        "MEDRUSH_ALLOW_CLEARTEXT": "true"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.medrush.app",
        "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "false",
        "MEDRUSH_ALLOW_CLEARTEXT": "false"
      }
    },
    "partner-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "partner",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.medrush.app",
        "EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE": "false",
        "MEDRUSH_ALLOW_CLEARTEXT": "false"
      }
    }
  }
}
