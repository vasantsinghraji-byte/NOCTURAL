#!/usr/bin/env bash
# ==============================================================================
# Pre-Commit Hook - Secret Leak Prevention
# ==============================================================================
# Prevents accidental commit of:
#   1. .env files (any variant)
#   2. Credential/key files
#   3. Hardcoded secrets detected in staged file contents
#
# Install: git config core.hooksPath .githooks
# (Automatically done via npm prepare script)
# ==============================================================================

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

BLOCKED=0

# ==============================================================================
# Layer 1: Block dangerous filenames from being committed
# ==============================================================================

BLOCKED_FILE_PATTERNS=(
  '\.env$'
  '\.env\.'
  'serviceAccountKey\.json'
  'credentials\.json'
  'firebase-credentials'
  'gcp-credentials'
  'aws-credentials'
  '\.pem$'
  '\.key$'
  '\.p12$'
  '\.pfx$'
  '\.keystore$'
  '\.jks$'
  'id_rsa'
  'id_dsa'
  'id_ecdsa'
  'id_ed25519'
  'mongodb-credentials'
)

# Allow .env.example explicitly
ALLOW_PATTERNS=(
  '\.env\.example$'
)

staged_files=$(git diff --cached --name-only --diff-filter=ACR 2>/dev/null || true)

# ==============================================================================
# Layer 0: Run Gitleaks when available, using the repo config
# ==============================================================================

GITLEAKS_BIN=""
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS_BIN="$(command -v gitleaks)"
elif [ -n "${LOCALAPPDATA:-}" ] && [ -x "${LOCALAPPDATA}/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_Microsoft.Winget.Source_8wekyb3d8bbwe/gitleaks.exe" ]; then
  GITLEAKS_BIN="${LOCALAPPDATA}/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_Microsoft.Winget.Source_8wekyb3d8bbwe/gitleaks.exe"
fi

if [ -n "$GITLEAKS_BIN" ]; then
  if ! "$GITLEAKS_BIN" git --pre-commit --redact --staged --verbose --config .gitleaks.toml; then
    BLOCKED=1
  fi
else
  echo -e "${YELLOW}WARN${NC} gitleaks is not installed; using built-in secret checks only."
fi

# Single-pass filename check: two greps over the whole file list instead of
# up to 18 grep processes per staged file (process spawn dominates on
# Windows bash and made large stages take minutes).
if [ -n "$staged_files" ]; then
  allow_re=$(IFS='|'; echo "${ALLOW_PATTERNS[*]}")
  blocked_re=$(IFS='|'; echo "${BLOCKED_FILE_PATTERNS[*]}")

  blocked_names=$(printf '%s\n' "$staged_files" | grep -viE "$allow_re" | grep -iE "$blocked_re" || true)
  if [ -n "$blocked_names" ]; then
    while IFS= read -r file; do
      echo -e "${RED}BLOCKED${NC} Sensitive file staged for commit: ${YELLOW}${file}${NC}"
    done <<< "$blocked_names"
    BLOCKED=1
  fi
fi

# ==============================================================================
# Layer 2: Scan staged file contents for secret patterns
# ==============================================================================

SECRET_PATTERNS=(
  # AWS
  'AKIA[0-9A-Z]{16}'
  # Generic API keys / tokens (long hex strings assigned to key-like variables)
  '(api_key|apikey|api_secret|secret_key|access_key|auth_token)\s*[=:]\s*["'"'"'][a-zA-Z0-9/+=_-]{20,}'
  # Private keys
  '-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----'
  # JWT tokens (three base64 segments separated by dots)
  'eyJ[a-zA-Z0-9_-]{10,}\.eyJ[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]+'
  # Connection strings with passwords
  'mongodb(\+srv)?://[^:]+:[^@]+@'
  'postgres(ql)?://[^:]+:[^@]+@'
  'mysql://[^:]+:[^@]+@'
  'redis://:[^@]+@'
  # Razorpay live keys (allow test keys)
  'rzp_live_[a-zA-Z0-9]+'
  # Google API keys
  'AIzaSy[a-zA-Z0-9_-]{33}'
  # Slack tokens
  'xox[bpors]-[a-zA-Z0-9-]+'
  # GitHub tokens
  'gh[pousr]_[a-zA-Z0-9]{36,}'
  # Generic password assignments — note: [[:space:]] not \s, because inside a
  # POSIX bracket expression \s is literal (backslash or "s"), which silently
  # excluded the letter s from matches and missed most real passwords.
  'password\s*[=:]\s*["'"'"'][^"'"'"'[:space:]]{8,}'
)

# Only scan text files that are staged (skip binaries, skip .env.example).
# Single-pass implementation: one `git diff --cached` for the whole stage
# instead of one git invocation (plus 15 greps) per staged file — the
# per-file loop took minutes on large stages such as copy-phase commits.
# Skip rules are unchanged; they are applied per file inside awk.
if [ -n "$staged_files" ]; then
  staged_added=$(git diff --cached -p 2>/dev/null | awk '
    /^\+\+\+ b\// {
      file = substr($0, 7)
      lf = tolower(file)
      skip = 0
      if (lf ~ /\.env\.example$/) skip = 1
      else if (lf ~ /\.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|pdf|zip|tar|gz|lock)$/) skip = 1
      else if (lf ~ /\.min\.(js|css)$/ || lf ~ /\.map$/) skip = 1
      else if (lf ~ /node_modules\//) skip = 1
      else if (lf ~ /\.githooks\//) skip = 1
      else if (lf ~ /\.test\.(js|ts)$/ || lf ~ /\.spec\.(js|ts)$/ || lf ~ /__tests__\//) skip = 1
      next
    }
    /^\+\+\+/ { skip = 1; next }
    skip { next }
    /^\+/ { print file "\t" substr($0, 2) }
  ')

  if [ -n "$staged_added" ]; then
    for pattern in "${SECRET_PATTERNS[@]}"; do
      match=$(printf '%s\n' "$staged_added" | grep -iE "$pattern" 2>/dev/null | head -1 || true)
      if [ -n "$match" ]; then
        file=${match%%$'\t'*}
        content=${match#*$'\t'}
        # Truncate the match for display (don't print the actual secret)
        truncated=$(printf '%s' "$content" | cut -c1-80)
        echo -e "${RED}BLOCKED${NC} Possible secret in ${YELLOW}${file}${NC}"
        echo -e "  Pattern: ${pattern}"
        echo -e "  Near:    ${truncated}..."
        BLOCKED=1
      fi
    done
  fi
fi

# ==============================================================================
# Verdict
# ==============================================================================

if [ "$BLOCKED" -ne 0 ]; then
  echo ""
  echo -e "${RED}========================================${NC}"
  echo -e "${RED} COMMIT BLOCKED - Secrets detected!${NC}"
  echo -e "${RED}========================================${NC}"
  echo ""
  echo "Bots scan every GitHub commit in real-time for exposed secrets."
  echo "Your keys can be compromised within seconds of pushing."
  echo ""
  echo "To fix:"
  echo "  1. Remove the flagged files:  git reset HEAD <file>"
  echo "  2. Add them to .gitignore"
  echo "  3. If already pushed, rotate ALL exposed credentials immediately"
  echo ""
  echo "To bypass (emergencies only):"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
